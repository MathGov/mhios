      },
      "required": [
        "status",
        "owner",
        "route",
        "record_ref"
      ]
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_level": {
          "enum": [
            "M0",
            "M1",
            "M2",
            "M3"
          ]
        },
        "assessment": {
          "enum": [
            "NOT_ASSESSED",
            "PARTIAL",
            "EXTERNAL_ASSESSMENT_RECORDED"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_ref"
          },
          "minItems": 0
        }
      },
      "required": [
        "target_level",
        "assessment",
        "evidence_refs"
      ]
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "provisional_choice": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "option_id",
            "record_ref",
            "controls_ref"
          ],
          "properties": {
            "option_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "record_ref": {
              "$ref": "#/$defs/record_ref"
            },
            "controls_ref": {
              "$ref": "#/$defs/record_ref"
            }
          }
        }
      ]
    }
  },
  "required": [
    "mhios_version",
    "core_release_id",
    "core_pin_manifest_sha256",
    "session_id",
    "revision_id",
    "record_mode",
    "created_at",
    "evidence_cutoff",
    "decision_question",
    "tier",
    "configuration",
    "roles",
    "stakeholder_discovery",
    "option_closure",
    "options",
    "robustness",
    "framework_verdict",
    "decision_state",
    "framework_selected_option_id",
    "authority_selection",
    "execution",
    "runtime",
    "emergency",
    "sgp_links",
    "blockers",
    "monitoring_and_outcome",
    "challenge_appeal",
    "conformance",
    "claim_boundary",
    "provisional_choice"
  ],
  "$defs": {
    "record_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "basis": {
          "enum": [
            "SYNTHETIC",
            "SUPPLIED_RECORD",
            "EXTERNAL_UNVERIFIED"
          ]
        }
      },
      "required": [
        "id",
        "locator",
        "sha256",
        "basis"
      ]
    }
  }
}
