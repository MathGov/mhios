            "record_ref": {
              "$ref": "#/$defs/record_ref"
            },
            "authority_ref": {
              "$ref": "#/$defs/record_ref"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            },
            "scope_and_exit": {
