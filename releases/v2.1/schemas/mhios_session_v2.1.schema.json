{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mathgov:mhios:2.1:session",
  "title": "MHIOS session projection, pinned Core 13.0 / SGP 8.8",
  "description": "MHIOS-owned projection only. Not the Canon run-record v4.1 schema. Null stage means locally not evaluated, never a canonical PASS. Positive record checks do not authorize execution.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mhios_version": {
      "const": "2.1"
    },
    "core_release_id": {
      "const": "MG-RL-13.0-20260926-RELEASE-I"
    },
    "core_pin_manifest_sha256": {
      "const": "b8ec26e3cac39c73ea513eee6ffa8737cb88a4efde44fda2bb3e0d1ae55a2357"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "revision_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "record_mode": {
      "enum": [
        "SYNTHETIC",
        "OBSERVED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "decision_question": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "tier": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "configuration_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "configuration_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "operating_envelope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model_or_software_versions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "tools_permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        },
        "active_controls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        },
        "material_change_since_qualification": {
          "type": "boolean"
        }
      },
      "required": [
        "configuration_id",
        "configuration_hash",
        "evaluated_at",
        "operating_envelope",
        "model_or_software_versions",
        "tools_permissions",
        "active_controls",
        "material_change_since_qualification"
      ]
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "holder": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "authority_scope": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "conflict": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "role",
          "holder",
          "authority_scope",
          "conflict"
        ]
      },
      "minItems": 1
    },
    "stakeholder_discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "methods": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "identified": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        },
        "representation_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        }
      },
      "required": [
        "methods",
        "identified",
        "unknowns",
        "representation_gaps"
      ]
    },
    "option_closure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "methods": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "mandatory_families_disposition": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "COMPLETE",
            "ASSUMPTION_BOUND",
            "OPTION_SET_THIN",
            "UNRESOLVED"
          ]
        },
        "record_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/record_ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "methods",
        "mandatory_families_disposition",
        "status",
        "record_ref"
      ]
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "option_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "states": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rg": {
                "enum": [
                  "RG_SUPPORTED",
                  "RG_NARROWED",
                  "RG_REFUSED",
                  null
                ]
              },
              "rf_ncrc": {
                "enum": [
                  "RF_PASS",
                  "RF_FAIL",
                  "RF_ESCALATE",
                  "NCRC_UNKNOWN",
                  null
                ]
              },
              "trc": {
                "enum": [
                  "TRC_PASS",
                  "TRC_NOT_TRIGGERED",
                  "TRC_FAIL",
                  "TRC_ESCALATE",
                  null
                ]
              },
              "csv": {
                "enum": [
                  "CSV_PASS",
                  "CSV_PASS_WITH_CONTROLS",
                  "CSV_NOT_MATERIAL",
                  "CSV_FAIL",
                  "CSV_REDESIGN_REQUIRED",
                  "CSV_ESCALATE",
                  "CSV_EMERGENCY_PROVISIONAL",
                  null
                ]
              },
              "rls": {
                "enum": [
                  "NOT_EVALUATED",
                  "RLS_RANKED"
                ]
              }
            },
            "required": [
              "rg",
              "rf_ncrc",
              "trc",
              "csv",
              "rls"
            ]
          },
          "record_refs": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rg": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/record_ref"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rf_ncrc": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/record_ref"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "trc": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/record_ref"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "trc_trigger": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/record_ref"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "csv": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/record_ref"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "controls": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/record_ref"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rls": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/record_ref"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "rg",
              "rf_ncrc",
              "trc",
              "trc_trigger",
              "csv",
              "controls",
              "rls"
            ]
          },
          "material_unresolved": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0
          },
          "requalification_required": {
            "type": "boolean"
          },
          "controls_available": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "rls_score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -1,
            "maximum": 1
          },
          "sigma_rls": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "option_id",
          "label",
          "states",
          "record_refs",
          "material_unresolved",
          "requalification_required",
          "controls_available",
          "rls_score",
          "sigma_rls"
        ]
      },
      "minItems": 1
    },
    "robustness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "COMPLETE",
            "INCOMPLETE",
            "SENSITIVE",
            "NOT_TRIGGERED_WITH_RATIONALE"
          ]
        },
        "record_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/record_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "required_variants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "comparisons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "variant_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "candidate_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "contender_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "signed_gap": {
                "type": "number"
              },
              "record_ref": {
                "$ref": "#/$defs/record_ref"
              }
            },
            "required": [
              "variant_id",
              "candidate_id",
              "contender_id",
              "signed_gap",
              "record_ref"
            ]
          },
          "minItems": 0
        },
        "joint_stress_disposition": {
          "enum": [
            "EVALUATED",
            "NOT_TRIGGERED_WITH_RATIONALE",
            "UNRESOLVED"
          ]
        },
        "joint_stress_rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "joint_record_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/record_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_basis": {
          "enum": [
            "ACCEPTED_FOR_DECLARED_CLAIM",
            "SYNTHETIC_STIPULATION",
            "PROVISIONAL_DEMONSTRATION",
            "UNASSESSED"
          ]
        },
        "delta": {
          "const": 2
        },
        "sole_survivor_record_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/record_ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "record_ref",
        "required_variants",
        "comparisons",
        "joint_stress_disposition",
        "joint_stress_rationale",
        "joint_record_ref",
        "evidence_basis",
        "delta",
        "sole_survivor_record_ref"
      ]
    },
    "framework_verdict": {
      "enum": [
        "BLOCK",
        "REFUSE_DETERMINISTIC_SELECTION",
        "ALLOW_FRAMEWORK_SELECTION",
        "ESCALATE",
        null
      ]
    },
    "decision_state": {
      "enum": [
        "SELECTED_DECISIVE",
        "SELECTED_BY_AUTHORITY_NON_DECISIVE",
        "PROVISIONAL_WITH_CONTROLS",
        "DELAY",
        "REDESIGN",
        "ESCALATE",
        "REFUSE",
        "NO_SELECTABLE_OPTION",
        "EMERGENCY_PROVISIONAL",
        null
      ]
    },
    "framework_selected_option_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "authority_selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "option_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "record_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/record_ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "option_id",
        "record_ref"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "NOT_AUTHORIZED",
            "AUTHORIZED_WITHIN_SCOPE",
            "EXECUTION_BLOCKED",
            "EXECUTED_UNDER_MONITORING"
          ]
        },
        "option_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "action_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "authorization_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/record_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "bound_configuration_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "authorized_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "controls_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/record_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution_event_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/record_ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "option_id",
        "action_id",
        "authorization_ref",
        "bound_configuration_id",
        "authorized_at",
        "expires_at",
        "controls_ref",
        "execution_event_ref"
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent_present": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            0,
            1,
            2,
            3,
            4
          ]
        },
        "connectivity": {
          "enum": [
            "CONNECTED",
            "RECOVERING",
            "ISOLATED"
